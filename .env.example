# --- لازم ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- اختیاری ---
# مدل‌های جایگزین اگر مدل اصلی خطا داد (با ویرگول جدا کنید)
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001,openai/gpt-4o-mini
# حداکثر پیام در دقیقه برای هر IP (۰ = بدون محدودیت)
# RATE_LIMIT_PER_MIN=12
# اگر پشت nginx/Cloudflare هستید ۱ بگذارید تا IP واقعی خوانده شود
# TRUST_PROXY=0
# دامنه‌هایی که اجازه دارند ویجت را جاسازی کنند (با ویرگول جدا)
# ALLOWED_ORIGINS=https://www.khanoumi.com
# اگر API قیمت را ریال برگرداند ۱۰ بگذارید تا به تومان تبدیل شود
# KHANOUMI_PRICE_DIVISOR=1
# ۰ یعنی مرحله برنامه‌ریز (یک تماس سریع اضافه به مدل) خاموش شود
# USE_PLANNER=1
